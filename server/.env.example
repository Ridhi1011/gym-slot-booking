PORT=4000
# Neon connection string (keep sslmode=verify-full)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=verify-full
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173
# Optional: enables "Continue with Google". OAuth client ID (type "Web application"),
# e.g. 1234-abc.apps.googleusercontent.com. Leave empty to disable.
GOOGLE_CLIENT_ID=
